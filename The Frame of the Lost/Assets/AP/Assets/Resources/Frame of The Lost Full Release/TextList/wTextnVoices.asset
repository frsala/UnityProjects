      prefabSizeInViewer: 0.5
      prefabRotationInViewer: {x: 1, y: 1, z: 1}
      uniqueItemID: 4
      itemType: 0
      audioPriority: 0
    - diaryTitle:
      - EXO-SHELL
      diaryTextDisplayState: 01
      diaryText:
      - "La nave espacial Exo Shell en la que nos encontramos, fue construida en
        el invierno de un a\xF1o indeterminado con el principal prop\xF3sito de servir
        de transporte en las expediciones espaciales. \n\nExo Shell requiere de un
        mantenimiento regular en la mayor\xEDa de sus instalaciones. \n\nNo la manipule
        sin los conocimientos adecuados.\r\n"
      diaryAudioClip:
      - {fileID: 0}
      diarySub:
      - showMore: 00
        startPointsClip:
        - 0
        firstLetter:
        - 0
        lastLetter: 1e000000
        bypasstextLayout: 00
        textSub:
        - 
