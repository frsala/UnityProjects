      itemType: 0
      audioPriority: 0
    - diaryTitle:
      - "Diagn\xF3stico Paciente"
      diaryTextDisplayState: 01
      diaryText:
      - "La salud de los afectados est\xE1 d\xEDa tras d\xEDa en declive.\n\nSe les
        recomienda reposo en sus camarotes y acudir de nuevo en caso de empeoramiento."
