      itemType: 0
      audioPriority: 0
    - diaryTitle:
      - "Memorias de la expedici\xF3n I"
      diaryTextDisplayState: 01
      diaryText:
      - "\xA1Bua! \r\n\r\nAl final Dalvoir ten\xEDa raz\xF3n, y c\xF3mo me alegra
        eso. \xA1Ese planeta estaba lleno de riqueza!\n\nTengo unas ganas tremendas
        de volver a casa y ense\xF1ar a mi familia todo lo que he conseguido.  \n\n\xA1SOMOS
        RICOS!\r\n"
      diaryAudioClip:
      - {fileID: 0}
      diarySub:
      - showMore: 00
        startPointsClip:
        - 0
        firstLetter:
        - 0
        lastLetter: 1e000000
        bypasstextLayout: 00
