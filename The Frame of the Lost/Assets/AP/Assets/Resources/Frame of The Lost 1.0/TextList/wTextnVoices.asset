      - {fileID: 0}
      refGameObject: {fileID: 0}
      showInInventory: 1
      prefabSizeInViewer: 0.5
      prefabRotationInViewer: {x: 1, y: 1, z: 1}
      uniqueItemID: 18
      itemType: 0
      audioPriority: 0
    - diaryTitle:
      - "Discusi\xF3n"
      diaryTextDisplayState: 01
      diaryText:
      - "Pff, \xA1no s\xE9 por qu\xE9 son tan ego\xEDstas! \n\nDespu\xE9s de la expedici\xF3n
        y de que Dalvoir se encerrara en su cuarto, la tripulaci\xF3n est\xE1 que
        echa humo, y encima varios miembros dicen que no se encuentran bien para
        hacer sus tareas. \n\nPrimero me dicen que tengo que asumir el cargo de gestor
        de drenaje, y ahora me piden que maneje a la tripulaci\xF3n...  Pero si yo
        solo soy fontanero. \xBFQue quieren que haga?"
      diaryAudioClip:
      - {fileID: 0}
      diarySub:
      - showMore: 00
        startPointsClip:
        - 0
        firstLetter:
        - 0
        lastLetter: 1e000000
        bypasstextLayout: 00
