      prefabRotationInViewer: {x: 1, y: 1, z: 1}
      uniqueItemID: 19
      itemType: 0
      audioPriority: 0
    - diaryTitle:
      - "\xBFDemasiada paz?"
      diaryTextDisplayState: 01
      diaryText:
      - Por fin un lugar tranquilo para descansar entre tanto caos.
